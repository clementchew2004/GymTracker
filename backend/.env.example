# Copy to .env and fill in. Never commit the real file.

# Postgres connection string. Neon, Supabase, Railway — anything Postgres.
#
# Point this at a DEVELOPMENT database, never the production one. On Neon that
# means a branch of its own (`dev`), which is a copy-on-write copy and so
# arrives already migrated and seeded. `prisma migrate dev` offers to reset the
# database when it detects drift, and running that against production data is
# unrecoverable.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs and verifies JWTs. Generate with: openssl rand -hex 32
# Changing it in production logs everyone out.
JWT_SECRET="replace-with-64-random-hex-chars"

# Comma-separated list of front ends allowed to call this API.
# Local development defaults to http://localhost:5173 if unset.
CORS_ORIGIN="http://localhost:5173"

# Assigned by the hosting platform in production. Leave unset locally.
# PORT=4000
